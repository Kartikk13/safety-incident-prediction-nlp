# PostgreSQL Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safety_incident_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Application Configuration
SAFETY_API_URL=http://127.0.0.1:8502
# Storage Backend Configuration ("local" or "s3" / "r2")
STORAGE_BACKEND=local
SAFETY_UPLOAD_DIR=private_uploads

# S3 / Cloudflare R2 Configuration (Optional, when STORAGE_BACKEND=s3)
# AWS_S3_BUCKET=safety-incident-uploads
# AWS_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_DEFAULT_REGION=auto
SAFETY_DEMO_MODE=false
DISABLE_SQLALCHEMY_CEXT=1
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

